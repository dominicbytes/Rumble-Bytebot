<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>StreamerBot.PlatformBridge.Core</AssemblyName>
    <RootNamespace>StreamerBot.PlatformBridge.Core</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- Every Bytebot package ships this DLL; omit per-repository metadata so the file is byte-identical. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateRepositoryUrlAttribute>false</GenerateRepositoryUrlAttribute>
    <Copyright>Copyright (c) 2026 Dominic Bytes</Copyright>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(StreamerBotPath)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Security" />
  </ItemGroup>
</Project>
